{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=studyhub.db"
  },
  "Jwt": {
    "Issuer": "StudyHubApi",
    "Audience": "StudyHubApiClients",
    "Key": "CHANGE_ME_TO_A_LONG_RANDOM_SECRET_KEY_32+_CHARS",
    "ExpiresMinutes": 120
  }
}
